{
  "Counter (function)": {
    "prefix": "counter",
    "body": [
      "counter ${1:name}(${2:args}):",
      "    ${3:standby}"
    ],
    "description": "Define a function"
  },
  "Gate (if)": {
    "prefix": "gate",
    "body": [
      "gate ${1:condition}:",
      "    ${2:standby}"
    ],
    "description": "if"
  },
  "Gate / divert (if / else)": {
    "prefix": "gatediv",
    "body": [
      "gate ${1:condition}:",
      "    ${2:standby}",
      "div:",
      "    ${3:standby}"
    ],
    "description": "if / else"
  },
  "Belt (for)": {
    "prefix": "belt",
    "body": [
      "belt ${1:bag} in ${2:bags}:",
      "    ${3:pa $1}"
    ],
    "description": "for loop"
  },
  "Belt over runway (for range)": {
    "prefix": "beltr",
    "body": [
      "belt ${1:i} in rwy(${2:10}):",
      "    ${3:pa $1}"
    ],
    "description": "for i in range(n)"
  },
  "Hold (while)": {
    "prefix": "hold",
    "body": [
      "hold ${1:condition}:",
      "    ${2:standby}"
    ],
    "description": "while loop"
  },
  "Terminal (class)": {
    "prefix": "terminal",
    "body": [
      "terminal ${1:Name}:",
      "    counter arrive(me${2:, arg}):",
      "        ${3:me.arg = arg}"
    ],
    "description": "Define a class with a constructor"
  },
  "Screen (try / except)": {
    "prefix": "screen",
    "body": [
      "screen:",
      "    ${1:standby}",
      "flagged ${2:Exception} as ${3:e}:",
      "    pa \"flagged:\", $3"
    ],
    "description": "try / except"
  },
  "Lounge (with)": {
    "prefix": "lounge",
    "body": [
      "lounge open(${1:path}) as ${2:f}:",
      "    ${3:pa $2.read()}"
    ],
    "description": "with block"
  },
  "Main guard": {
    "prefix": "main",
    "body": [
      "gate __name__ == \"__main__\":",
      "    ${1:main()}"
    ],
    "description": "Run only when executed directly"
  }
}

{
  "name": "ayrport",
  "displayName": "Ayrport",
  "description": "Language support for Ayrport, the programming language spoken in airport and flight terms.",
  "version": "1.3.2",
  "publisher": "megazron",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/megazron/ayrport"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "ayrport",
    "ayr",
    "airport",
    "language",
    "python"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:ayrport"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ayrport",
        "aliases": [
          "Ayrport",
          "ayr"
        ],
        "extensions": [
          ".ayr"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/file-icon.svg",
          "dark": "./images/file-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "ayrport",
        "scopeName": "source.ayrport",
        "path": "./syntaxes/ayrport.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "ayrport",
        "path": "./snippets/ayrport.json"
      }
    ],
    "commands": [
      {
        "command": "ayrport.run",
        "title": "Ayrport: Run File",
        "icon": "$(play)"
      },
      {
        "command": "ayrport.showPython",
        "title": "Ayrport: Show Compiled Python"
      },
      {
        "command": "ayrport.tower",
        "title": "Ayrport: Open Tower (REPL)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "ayrport.run",
          "when": "resourceLangId == ayrport",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "ayrport.run",
          "when": "resourceLangId == ayrport",
          "group": "navigation@1"
        },
        {
          "command": "ayrport.showPython",
          "when": "resourceLangId == ayrport",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "ayrport.run",
          "when": "resourceExtname == .ayr",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "ayrport.run",
          "when": "editorLangId == ayrport"
        },
        {
          "command": "ayrport.showPython",
          "when": "editorLangId == ayrport"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ayrport.run",
        "key": "f5",
        "when": "editorLangId == ayrport && !inDebugMode"
      },
      {
        "command": "ayrport.run",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "editorLangId == ayrport"
      }
    ],
    "configuration": {
      "title": "Ayrport",
      "properties": {
        "ayrport.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python used to run Ayrport. Leave empty to use the Python extension's interpreter, or `py`/`python3`/`python` from PATH."
        },
        "ayrport.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Check .ayr files for errors when they are opened or saved, and underline the bad line."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node scripts/bundle-python.js"
  }
}

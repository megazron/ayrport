{
  "comments": { "lineComment": "#", "blockComment": ["\"\"\"", "\"\"\""] },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""], ["'", "'"]],
  "folding": { "offSide": true, "markers": { "start": "^\\s*#\\s*region\\b", "end": "^\\s*#\\s*endregion\\b" } },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(clr|alt|div|hold|taxi|fly|hangar|pre|mayday|post|gate|if|elif|else|while|for|def|class|try|except|finally|with|async)\\b.*:\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\s*(alt|div|mayday|post|elif|else|except|finally)\\b.*:"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(?:clr|alt|div|hold|taxi|fly|hangar|pre|mayday|post|gate|if|elif|else|while|for|def|class|try|except|finally|with|async)\\b.*:\\s*(#.*)?$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^\\s+(?:land|abort|around|idle|sos|return|break|continue|pass|raise)\\b.*$",
      "action": { "indent": "outdent" }
    }
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*"
}

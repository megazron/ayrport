# files.ayr — lounge opens a resource and closes it after (with)
load os, tempfile

path = os.path.join(tempfile.gettempdir(), "ayrport_manifest.txt")

lounge open(path, "w") as f:
    belt seat, who in enumerate(["Ana", "Ben", "Cy"], 1):
        f.write(f"{seat}: {who}\n")

lounge open(path) as f:
    pa f.read(), end=""

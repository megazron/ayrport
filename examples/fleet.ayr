# fleet.ayr — classes are terminals, `me` is self, screen/flagged/customs is try/except/finally

terminal Aircraft:
    counter arrive(me, callsign, seats):
        me.callsign = callsign
        me.seats = seats
        me.onboard = []

    counter board(me, passenger):
        gate len(me.onboard) >= me.seats:
            flag OverbookedError(f"{me.callsign} is full")
        me.onboard.append(passenger)

    counter __repr__(me):
        depart f"<{me.callsign} {len(me.onboard)}/{me.seats}>"


terminal Jumbo(Aircraft):
    counter arrive(me, callsign):
        super().arrive(callsign, seats=3)


terminal OverbookedError(Exception):
    standby


plane = Jumbo("AY101")
belt p in ["Ana", "Ben", "Cy", "Dee"]:
    screen:
        plane.board(p)
        pa "boarded", p
    flagged OverbookedError as e:
        pa "MAYDAY:", e
    customs:
        pa "  ", plane

xray len(plane.onboard) == 3, "checklist: three on board"

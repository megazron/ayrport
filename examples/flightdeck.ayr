# flightdeck.ayr — an Ayrport module, imported from Python in embed.py

counter eta(distance_km, speed_kmh=850):
    "Hours to destination."
    depart round(distance_km / speed_kmh, 2)

counter callsign(airline, number):
    depart f"{airline.upper()}{number:03d}"

terminal Runway:
    counter arrive(me, name, length_m):
        me.name = name
        me.length_m = length_m

    counter fits(me, aircraft_needs_m):
        depart me.length_m >= aircraft_needs_m

# basics.ayr — the whole language in one terminal

load sqrt, pi from math
load random

# functions: counter ... depart
counter fuel_needed(km, burn=3.2):
    depart km * burn

# if / elif / else: gate / alt / div
counter status(delay):
    gate delay == 0:
        depart "ON TIME"
    alt delay < 30:
        depart "DELAYED"
    div:
        depart "CANCELLED"

# for: belt ... in
belt d in [0, 12, 95]:
    pa f"delay {d:>3} min -> {status(d)}"

# while: hold (the hold room)
queue = ["Ana", "Ben", "Cy"]
hold queue:
    pa "now serving", queue.pop(0)

# break / continue: leave / skip
belt gate_no in rwy(1, 10):
    gate gate_no % 2 == 0:
        skip
    gate gate_no > 7:
        leave
    pa "odd gate", gate_no

# lambdas: kiosk
double = kiosk x: x * 2
pa "double 21 =", double(21)

# one-line choice: gate ... div
fuel = fuel_needed(500)
pa "fuel ok" gate fuel < 2000 div "need more fuel"

# go / nogo / nil  (True / False / None)
boarding = go
pa "boarding:", boarding, "| nogo:", nogo, "| nil:", nil

# generators: drop (bag drop)
counter countdown(n):
    hold n > 0:
        drop n
        n -= 1
pa "countdown:", list(countdown(5))

pa "sqrt(2) =", round(sqrt(2), 3), "pi =", round(pi, 3)
